#!/bin/sh
# GoGoHam-Live-Stick: beim ersten Anmelden den GoGoHam-Hintergrund setzen (danach nie wieder –
# wer einen anderen wählt, behält ihn)
stamp="$HOME/.config/gogoham-hintergrund"
[ -e "$stamp" ] && exit 0
bild=/usr/share/wallpapers/GoGoHam/contents/images/2560x1440.png
i=0
while [ "$i" -lt 30 ]; do
    if plasma-apply-wallpaperimage "$bild" >/dev/null 2>&1; then
        mkdir -p "$HOME/.config" && touch "$stamp"
        exit 0
    fi
    sleep 2
    i=$((i + 1))
done
