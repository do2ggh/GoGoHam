#!/bin/sh
# GoGoHam-Live-Stick: Austausch-Ordner (exFAT, Name „GoGoHam“) im Benutzerordner einhängen
dev=/dev/disk/by-label/GoGoHam
i=0
while [ ! -e "$dev" ] && [ "$i" -lt 10 ]; do sleep 1; i=$((i + 1)); done
[ -e "$dev" ] || exit 0
user=gogoham
uid=$(id -u "$user" 2>/dev/null || echo 1000)
gid=$(id -g "$user" 2>/dev/null || echo 1000)
dir=/home/$user/Austausch
mkdir -p "$dir"
chown "$uid:$gid" "$dir" 2>/dev/null || true
mountpoint -q "$dir" && exit 0
exec mount -t exfat -o "uid=$uid,gid=$gid,umask=0022,noatime" "$dev" "$dir"
