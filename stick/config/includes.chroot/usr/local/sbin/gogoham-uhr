#!/bin/sh
# GoGoHam-Live-Stick, früh beim Start: Wie führt dieser Rechner seine eingebaute Uhr?
# Windows: in Ortszeit, Linux/macOS: in UTC. Ist Windows auf einem eingebauten Laufwerk
# (NTFS, BitLocker oder eine „Microsoft reserviert“-Partition), nehmen wir Ortszeit an, sonst UTC –
# und lesen die Uhr danach neu.
# Die eingebaute Uhr wird nur GELESEN, nie verändert (kein hwclock – das hängt auf manchen
# Rechnern und in virtuellen Maschinen, siehe 8. Bau).
# Aufruf ohne Argument: erkennen + lesen; „lesen“: nur neu lesen (nach Zeitzonen-Wechsel).
# Was erkannt wurde, steht in /var/log/gogoham-uhr.log (bleibt auf dem Stick – das Systemprotokoll
# liegt seit dem 13. Bau nur im Arbeitsspeicher).
LOG=/var/log/gogoham-uhr.log
MSR=e3c9e316-0b5c-4db8-817d-f92df00215ae          # Partitionstyp „Microsoft reserviert“

windows() {   # gibt die gefundene Windows-Spur aus (leer = keine)
    # nur eingebaute Laufwerke: keine USB-Geräte, nichts Wechselbares (Stick, USB-Festplatte)
    intern=$(lsblk -drnpo NAME,TYPE,RM,TRAN 2>/dev/null | awk '$2=="disk" && $3=="0" && $4!="usb" {print $1}')
    for d in $(lsblk -rnpo NAME,TYPE,PKNAME 2>/dev/null | awk '$2=="part" {print $1, $3}' | \
               while read -r p k; do echo "$intern" | grep -qx "$k" && echo "$p"; done); do
        t=$(lsblk -dno FSTYPE "$d" 2>/dev/null)
        [ -n "$t" ] || t=$(blkid -p -s TYPE -o value "$d" 2>/dev/null)
        case "$t" in ntfs|BitLocker) echo "$d $t"; return 0 ;; esac
        pt=$(lsblk -dno PARTTYPE "$d" 2>/dev/null)
        [ "$pt" = "$MSR" ] && { echo "$d Microsoft-reserviert"; return 0; }
    done
    return 1
}

if [ "$1" != lesen ]; then
    mode=UTC
    spur=""
    # eingebaute Laufwerke (z. B. eMMC) melden sich manchmal erst nach ein paar Sekunden – nur
    # dann warten (höchstens 8 s). Ist eins da und kein Windows drauf: sofort weiter (sonst
    # startete jeder Rechner ohne Windows 8 s langsamer, VM-Test 13. Bau).
    i=0
    while [ "$i" -lt 8 ]; do
        spur=$(windows) && { mode=LOCAL; break; }
        lsblk -drno TYPE,RM,TRAN,NAME 2>/dev/null | \
            awk '$1=="disk" && $2=="0" && $3!="usb" && $NF !~ /^zram/' | \
            grep -q . && break
        sleep 1
        i=$((i + 1))
    done
    printf '0.0 0 0.0\n0\n%s\n' "$mode" > /etc/adjtime
    {
        echo "== $(date -u '+%Y-%m-%d %H:%M:%S') UTC (vor dem Lesen) – Ergebnis: $mode ${spur:+($spur)} nach ${i} s"
        lsblk -rno NAME,TYPE,FSTYPE,PARTTYPE,SIZE 2>/dev/null
    } >> "$LOG" 2>&1
    echo "GoGoHam: eingebaute Uhr wird als $mode gelesen ${spur:+($spur)}"
fi
mode=$(tail -n1 /etc/adjtime 2>/dev/null)
raw=$(cat /sys/class/rtc/rtc0/since_epoch 2>/dev/null) || exit 0
[ -n "$raw" ] || exit 0
if [ "$mode" = LOCAL ]; then
    # Die eingebaute Uhr zeigt Ortszeit; der Kernel hat sie als UTC gelesen → als Ortszeit deuten
    wall=$(date -u -d "@$raw" '+%Y-%m-%d %H:%M:%S')
    epoch=$(date -d "$wall" +%s) || exit 0
else
    epoch=$raw
fi
date -s "@$epoch" >/dev/null && echo "GoGoHam: Uhr gelesen: $(date -u '+%H:%M:%S') UTC" | tee -a "$LOG"
exit 0
