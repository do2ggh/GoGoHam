[Unit]
Description=GoGoHam-Live-Stick: Austausch-Ordner einhängen
After=live-config.service local-fs.target
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gogoham-austausch
ExecStop=/bin/umount -l /home/gogoham/Austausch

[Install]
WantedBy=multi-user.target
