#!/bin/sh
# GoGoHam-Live-Stick: Datenteil leeren, wenn „Werkseinstellungen“ gewählt wurde.
# Läuft vor live-boot, also bevor der Datenteil benutzt wird.
# Außerdem: nach einem neuen Abbild (Stick aktualisieren, Daten bleiben) die alten
# overlay-Verweise „trusted.overlay.origin“ entfernen – sie passen nicht mehr zum neuen Abbild.
PREREQ="udev gogoham-einrichten"   # erst einrichten (frischer Stick), dann zurücksetzen
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

grep -q persistence /proc/cmdline || exit 0
dev=/dev/disk/by-label/GGH-DATEN
i=0
while [ ! -e "$dev" ] && [ "$i" -lt 10 ]; do
    sleep 1
    i=$((i + 1))
done
[ -e "$dev" ] || exit 0
mnt=/run/gogoham-reset
mkdir -p "$mnt"
modprobe ext4 2>/dev/null || true
mount -t ext4 "$dev" "$mnt" 2>/dev/null || exit 0
if [ -e "$mnt/GOGOHAM-ZURUECKSETZEN" ]; then
    echo "GoGoHam: Stick wird auf Werkseinstellungen zurückgesetzt ..."
    for f in "$mnt"/* "$mnt"/.[!.]* "$mnt"/..?*; do
        case "${f##*/}" in
            persistence.conf|lost+found) continue ;;
        esac
        [ -e "$f" ] || [ -L "$f" ] || continue
        rm -rf "$f"
    done
    sync
fi
neu=$(cat /etc/gogoham-build 2>/dev/null)
alt=$(cat "$mnt/.gogoham-build" 2>/dev/null)
if [ -n "$neu" ] && [ "$neu" != "$alt" ]; then
    if [ -d "$mnt/rw" ]; then
        echo "GoGoHam: Stick wurde aktualisiert – Daten werden angepasst ..."
        find "$mnt/rw" -xdev -print0 2>/dev/null | \
            xargs -0 -r setfattr -h -x trusted.overlay.origin 2>/dev/null
    fi
    printf '%s' "$neu" > "$mnt/.gogoham-build"
    sync
fi
umount "$mnt"
exit 0
